# Claude API key. Without it the app runs in demo mode (scripted answers, no LLM).
ANTHROPIC_API_KEY=

# Postgres connection string (Vercel Postgres / Neon / Supabase). Leave empty locally to use the
# embedded PGlite database stored under data/pglite.
DATABASE_URL=

# Optional tuning
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=1          # set 0 to disable server-side refusal fallbacks
# MOCK_LLM=0                  # set 1 to force demo mode even with a key
